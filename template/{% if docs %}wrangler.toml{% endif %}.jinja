name = "{{project_name}}"
compatibility_date = "2025-06-28"
workers_dev = true
preview_urls = true

routes = [
  # https://developers.cloudflare.com/workers/configuration/routing/routes/
  # https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
{%- if docs_route|length > 0 %}
  { pattern = "{{home_domain}}{{docs_route}}*", zone_name = "{{home_domain}}" },
{%- else %}
  { pattern = "{{home_domain}}", zone_name = "{{home_domain}}", custom_domain = true },
{%- endif %}
]

[assets]
directory = "public"
not_found_handling = "404-page"
